# 大模型密钥
LLM_API_KEY=


# ===== 模型接口 =====
LLM_BASE_URL=
LLM_MODEL=


# 单次请求超时（秒），思考模型响应慢，可以适当调大
LLM_TIMEOUT=120


# 思考模型
LLM_EXTRA_BODY={"thinking": {"type": "enabled"}}


# ===== Agent 行为 =====
# 工作区根目录，文件工具只能在这个范围内读写。相对路径以项目根目录为基准。
# 可以指向某个代码仓库来让它只在那里面干活。
# AGENT_WORKSPACE=.


# 人设文件名，相对工作区
AGENT_IDENTITY_FILE=identity.md


# 单轮对话最多调用模型的次数，防止任务不收敛时无限跑
AGENT_MAX_STEPS=50


# 单次请求的历史 token 预算（按字符数粗估，约 2 字符 = 1 token）。
# 超过它时自动把中间那段旧消息摘要成一条 system 消息，只保留 System Prompt 和最近 6 条，
# 被压缩掉的原文归档到 workspace/memory/HISTORY.md。
# 0 或留空 = 关闭自动压缩（默认）。示例：AGENT_TOKEN_BUDGET=8000
AGENT_TOKEN_BUDGET=0


# 长期记忆文件（MEMORY.md）的位置，相对项目根目录。
# agent 用 save_memory 工具往里写，每轮对话都会读出来放进 System Prompt。
# 默认就是下面这个值——放在工作区数据目录下，不散落在项目根。
# AGENT_MEMORY_FILE=workspace/memory/MEMORY.md


# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO


# ===== 联网搜索（博查 Web Search API）=====
# 申请地址：https://open.bochaai.com 。留空时 web_search 工具返回“未配置”提示，
# 其余工具与对话不受影响。
BOCHA_API_KEY=


# ===== QQ 官方机器人（QQ 开放平台）=====
# 申请地址：https://q.qq.com 。填了下面两项才启用 QQ 渠道，留空则只跑 CLI。
# 需要先安装 SDK：pip install qq-botpy
# 机器人需要开通"群聊"与"单聊"权限；群消息只在被 @ 时才会推给机器人。
# AppSecret 是密钥，不要提交到版本库，也不要外发。
QQ_APP_ID=
QQ_APP_SECRET=


# ===== 子智能体（spawn_subagent）=====
# 主 agent 可以把"过程长、结论短"的活（翻多个文件才答一个问题、连续试错、汇总搜索结果）
# 派给一个临时子 agent 执行，拿回结论而不把中间过程留在主对话里。
# 它默认走阿里云百炼，与主模型配置互相独立：填了 SUBAGENT_API_KEY 才启用这个工具。
# 申请地址：https://bailian.console.aliyun.com
# SUBAGENT_BASE_URL 留空则用百炼的 OpenAI 兼容入口。
SUBAGENT_API_KEY=
SUBAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUBAGENT_MODEL=qwen3.8-flash
